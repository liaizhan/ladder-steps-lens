    - '// @input float breathPhaseSeconds = 4 {"hint":"Seconds per breathing phase (in, hold, out, hold). 4 = brief default"}'
    - '// @input float breathRounds = 3 {"hint":"Breathing rounds per step"}'
    - '// @input float floorBelowEyes = 150 {"hint":"STAND-IN: floor height below the camera start, in cm (no real floor in the preview)"}'
