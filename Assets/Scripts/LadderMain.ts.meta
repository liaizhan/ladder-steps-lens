  InputLines:
    - '// @ui {"widget":"label", "label":"Ladder Steps: main flow (pick, climb, breathe, goal cards, saved progress)"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Wiring"}'
